// Demo data for local development: a sector-neutral shop with 10 products.
//   npm run db:seed:local
// Writes seed/demo.sql and runs it on the LOCAL D1. Never touches a deployed
// shop. Products have no photos: the storefront draws placeholder frames.
// Run with plain Node (≥ 22.18), which strips the TypeScript types.
import { execFileSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { demoCatalog } from "../seed/demo-catalog.ts";
import { normalizeSearch, slugify } from "../src/shared/text.ts";

type LT = { az: string; ru?: string; en?: string };

const root = path.resolve(import.meta.dirname, "..");
const now = new Date().toISOString();

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "NULL";
  if (typeof v === "number") return String(Math.round(v));
  if (typeof v === "boolean") return v ? "1" : "0";
  const s = typeof v === "string" ? v : JSON.stringify(v);
  return `'${s.replace(/'/g, "''")}'`;
};
const qepik = (manat: number) => Math.round(manat * 100);
const attrKey = (name: string) => slugify(name).replace(/-/g, "_").slice(0, 40);

/** {az, ru, en} → per-language overrides for one field */
function addTr(target: Record<string, Record<string, unknown>>, field: string, t: LT | undefined) {
  if (!t) return;
  for (const lang of ["ru", "en"] as const) {
    if (t[lang] && t[lang] !== t.az) (target[lang] ??= {})[field] = t[lang];
  }
}
const join = (a: LT, b: LT): LT => ({
  az: [a.az, b.az].join("\n\n"),
  ru: a.ru || b.ru ? [a.ru ?? a.az, b.ru ?? b.az].join("\n\n") : undefined,
  en: a.en || b.en ? [a.en ?? a.az, b.en ?? b.az].join("\n\n") : undefined,
});

const sql: string[] = [
  "-- generated by scripts/seed-demo.mts",
  "DELETE FROM order_items;",
  "DELETE FROM orders;",
  "DELETE FROM product_variants;",
  "DELETE FROM products;",
  "DELETE FROM attributes;",
  "DELETE FROM categories;",
  "DELETE FROM pages;",
  "DELETE FROM settings WHERE key NOT IN ('app.schema', 'setup.completed');",
  "DELETE FROM sqlite_sequence WHERE name IN ('products', 'product_variants', 'attributes', 'categories', 'pages', 'orders', 'order_items');",
];

/* settings */
const settings: Record<string, unknown> = {
  "store.name": "Demo Mağaza",
  "store.description": { az: "Hər sahəyə uyğun mağaza şablonu", ru: "Шаблон магазина для любой сферы", en: "A shop template for any trade" },
  "store.language": "az",
  "store.languages": ["az", "ru", "en"],
  "contact.phone": "+994 00 000 00 00",
  "contact.whatsapp": "994000000000",
  "contact.address": { az: "Bakı, Azərbaycan", ru: "Баку, Азербайджан", en: "Baku, Azerbaijan" },
  "contact.hours": { az: "Hər gün 10:00 – 20:00", ru: "Ежедневно 10:00 – 20:00", en: "Every day 10:00 – 20:00" },
  "notify.whatsapp_button_enabled": true,
};
for (const [k, v] of Object.entries(settings)) {
  sql.push(`INSERT INTO settings (key, value) VALUES (${q(k)}, ${q(JSON.stringify(v))});`);
}

/* categories */
const catId = new Map<string, number>();
demoCatalog.categories.forEach((c, i) => {
  const id = i + 1;
  catId.set(c.id, id);
  const tr: Record<string, Record<string, unknown>> = {};
  addTr(tr, "name", c.name);
  sql.push(
    `INSERT INTO categories (id, name, slug, sort_order, translations) VALUES (${id}, ${q(c.name.az)}, ${q(c.id)}, ${i}, ${q(Object.keys(tr).length ? tr : null)});`,
  );
});

/* attributes: brand, every variant option, every spec line */
type Attr = {
  key: string;
  name: LT;
  type: "text" | "select" | "color";
  options: (string | { value: string; hex?: string })[];
  optionTr: Record<"ru" | "en", Record<string, string>>;
  filterable: boolean;
  variant: boolean;
  cats: Set<number>;
};
const attrs = new Map<string, Attr>();
const attr = (key: string, init: Omit<Attr, "options" | "optionTr" | "cats">) => {
  let a = attrs.get(key);
  if (!a) attrs.set(key, (a = { ...init, options: [], optionTr: { ru: {}, en: {} }, cats: new Set() }));
  return a;
};

const brand = attr("brand", { key: "brand", name: { az: "Brend", ru: "Бренд", en: "Brand" }, type: "select", filterable: true, variant: false });
for (const p of demoCatalog.products) {
  if (!brand.options.includes(p.brand)) brand.options.push(p.brand);
  for (const o of p.options) {
    const a = attr(o.id, { key: o.id, name: o.name, type: o.values.some((v) => v.swatch) ? "color" : "select", filterable: true, variant: true });
    a.cats.add(catId.get(p.category)!);
    for (const v of o.values) {
      const label = v.name.az;
      if (!a.options.some((x) => (typeof x === "string" ? x : x.value) === label)) a.options.push(v.swatch ? { value: label, hex: v.swatch } : label);
      if (v.name.ru && v.name.ru !== label) a.optionTr.ru[label] = v.name.ru;
      if (v.name.en && v.name.en !== label) a.optionTr.en[label] = v.name.en;
    }
  }
  for (const s of p.specs) {
    const a = attr(attrKey(s.name.az), { key: attrKey(s.name.az), name: s.name, type: "text", filterable: false, variant: false });
    a.cats.add(catId.get(p.category)!);
  }
}
brand.options.sort();
let attrOrder = 0;
for (const a of attrs.values()) {
  const tr: Record<string, Record<string, unknown>> = {};
  addTr(tr, "name", a.name);
  for (const lang of ["ru", "en"] as const) if (Object.keys(a.optionTr[lang]).length) (tr[lang] ??= {}).options = a.optionTr[lang];
  sql.push(
    `INSERT INTO attributes (name, key, type, options, filterable, is_variant, category_ids, sort_order, translations) VALUES (${q(a.name.az)}, ${q(a.key)}, ${q(a.type)}, ${q(a.options.length ? a.options : null)}, ${q(a.filterable)}, ${q(a.variant)}, ${q(a.variant || a.key === "brand" ? null : [...a.cats])}, ${attrOrder++}, ${q(Object.keys(tr).length ? tr : null)});`,
  );
}

/* products and variants */
demoCatalog.products.forEach((p, i) => {
  const id = i + 1;
  const prices = p.variants.map((v) => v.price);
  const single = p.options.length === 0 && p.variants.length === 1 ? p.variants[0] : null;
  const attributes: Record<string, unknown> = { brand: p.brand };
  const tr: Record<string, Record<string, unknown>> = {};
  const text = join(p.summary, p.description);
  addTr(tr, "name", p.name);
  addTr(tr, "description", text);
  for (const s of p.specs) {
    const key = attrKey(s.name.az);
    attributes[key] = s.value.az;
    for (const lang of ["ru", "en"] as const) {
      const v = s.value[lang];
      if (v && v !== s.value.az) (((tr[lang] ??= {}).attributes ??= {}) as Record<string, string>)[key] = v;
    }
  }
  const optionLabel = (optionId: string, valueId: string) => p.options.find((o) => o.id === optionId)?.values.find((v) => v.id === valueId)?.name.az ?? valueId;
  const search = normalizeSearch(
    [p.name.az, p.name.ru, p.name.en, p.brand, demoCatalog.categories.find((c) => c.id === p.category)?.name.az, ...Object.values(attributes).map(String)]
      .filter(Boolean)
      .join(" "),
  );

  sql.push(
    `INSERT INTO products (id, category_id, name, slug, description, price, old_price, stock, images, attributes, is_active, is_featured, sort_order, created_at, updated_at, translations, search_text) VALUES (${id}, ${catId.get(p.category)}, ${q(p.name.az)}, ${q(p.slug)}, ${q(text.az)}, ${qepik(Math.min(...prices))}, ${q(single?.oldPrice ? qepik(single.oldPrice) : null)}, ${q(single ? single.stock : null)}, '[]', ${q(attributes)}, 1, ${q(!!p.featured)}, ${i}, ${q(new Date(p.addedAt).toISOString())}, ${q(now)}, ${q(Object.keys(tr).length ? tr : null)}, ${q(search)});`,
  );
  if (!single) {
    p.variants.forEach((v, j) => {
      const options = Object.fromEntries(Object.entries(v.values).map(([k, val]) => [k, optionLabel(k, val)]));
      sql.push(
        `INSERT INTO product_variants (product_id, options, price, old_price, stock, sort_order) VALUES (${id}, ${q(options)}, ${qepik(v.price)}, ${q(v.oldPrice ? qepik(v.oldPrice) : null)}, ${q(v.stock)}, ${j});`,
      );
    });
  }
});

/* two example pages for the menu */
const pages = [
  {
    slug: "catdirilma",
    title: { az: "Çatdırılma", ru: "Доставка", en: "Delivery" },
    content: {
      az: "Sifarişdən sonra sizinlə əlaqə saxlayıb çatdırılma vaxtını razılaşdırırıq.\n\n- Bakı daxilində: 1–2 gün\n- Regionlara: 2–4 gün",
      ru: "После заказа мы свяжемся с вами и согласуем время доставки.\n\n- По Баку: 1–2 дня\n- В регионы: 2–4 дня",
      en: "After you order, we contact you to agree on a delivery time.\n\n- Within Baku: 1–2 days\n- Other regions: 2–4 days",
    },
  },
  {
    slug: "qaytarma",
    title: { az: "Qaytarma", ru: "Возврат", en: "Returns" },
    content: {
      az: "Məhsulu 14 gün ərzində, istifadə olunmamış halda qaytara bilərsiniz. Bunun üçün bizə zəng edin və ya yazın.",
      ru: "Товар можно вернуть в течение 14 дней, если он не использовался. Для этого позвоните или напишите нам.",
      en: "You can return an unused item within 14 days. Just call or message us.",
    },
  },
];
pages.forEach((pg, i) => {
  const tr = { ru: { title: pg.title.ru, content: pg.content.ru }, en: { title: pg.title.en, content: pg.content.en } };
  sql.push(
    `INSERT INTO pages (slug, title, content, is_active, show_in_menu, sort_order, translations, updated_at) VALUES (${q(pg.slug)}, ${q(pg.title.az)}, ${q(pg.content.az)}, 1, 1, ${i}, ${q(tr)}, ${q(now)});`,
  );
});

const out = path.join(root, "seed", "demo.sql");
fs.writeFileSync(out, sql.join("\n") + "\n");
console.log(`seed: ${sql.length} statements → ${path.relative(root, out)}`);

execFileSync("npx", ["wrangler", "d1", "execute", "DB", "--local", "--file", "seed/demo.sql"], {
  cwd: root,
  stdio: ["ignore", "ignore", "inherit"],
  shell: true,
});
console.log("seed: D1 (local) done — 10 products, 4 categories, 2 pages");
